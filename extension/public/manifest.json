{
  "manifest_version": 3,
  "name": "Trợ lý Thẩm định Y lệnh (Độc lập)",
  "version": "1.10.0",
  "description": "Đọc tab EMR đang mở và ảnh chụp bảng y lệnh OH (che PII tại trình duyệt) để hỗ trợ dược sĩ thẩm định lâm sàng.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Mở bảng thẩm định y lệnh"
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "permissions": ["sidePanel", "tabs", "scripting", "storage"],
  "host_permissions": [
    "http://localhost:8001/*",
    "http://127.0.0.1:8001/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
