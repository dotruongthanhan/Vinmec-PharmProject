      "phieu_dieu_tri": [
        {
          "phieu_dieu_tri_id": "PDT-HS-017-1-01",
          "ngay_dieu_tri": 1,
          "thoi_diem_lap": "2026-11-12T17:30:00+07:00",
          "vai_tro_nguoi_lap": "bac_si_truc",
          "dien_bien": "BN nữ 45 tuổi ngã khi đi bộ ở nhà, đau nhiều cẳng chân trái, XQ ghi nhận gãy xương chày trái. Khám BN tỉnh, cẳng chân trái sưng, đau khi vận động, mạch mu chân bắt được, không tê bì. Cân nặng 62 kg. Đã nhập khoa Ngoại chỉnh hình, chuẩn bị mổ kết hợp xương.",
          "danh_gia": "Gãy xương chày trái sau chấn thương, có đau nhiều, chưa có dấu hiệu thiếu máu chi. Chưa dùng thuốc giảm đau trước khi vào viện. Không có bệnh mạn tính đáng kể.",
          "huong_xu_tri": "Kê cao chi trái. Truyền natri clorid 0,9% 500 mL trong 8 giờ mỗi ngày. Chỉ định ibuprofen 400 mg uống sau ăn 3 lần mỗi ngày để giảm đau. Chuẩn bị mổ kết hợp xương chày trái ngày mai, theo dõi sau mổ.",
          "y_lenh_trong_ngay": [
            "YL-HS-017-01",
            "YL-HS-017-02"
          ],
          "che_do_cham_soc": "cấp 2",
          "che_do_an": "Ăn bình thường, nhịn ăn theo hướng dẫn gây mê trước mổ",
          "theo_doi": [
            "Mạch, huyết áp, nhiệt độ mỗi 6 giờ",
            "Tình trạng tưới máu và cảm giác chi trái"
          ],
          "dan_do": "Nằm kê cao chân trái, không đặt tải lên chân trái khi chưa có hướng dẫn."
        },
        {
          "phieu_dieu_tri_id": "PDT-HS-017-1-02",
          "ngay_dieu_tri": 2,
          "thoi_diem_lap": "2026-11-13T09:00:00+07:00",
          "vai_tro_nguoi_lap": "bac_si_dieu_tri",
          "dien_bien": "Ngày 1 sau mổ kết hợp xương chày trái. Vết mổ khô, không chảy dịch. Đau giảm sau uống thuốc. BN đi lại có nạng, chưa đặt tải chi trái. BN ăn được và đi tiểu tự nhiên. Creatinin 68 umol/L.",
          "danh_gia": "Sau mổ kết hợp xương ngày đầu, vết mổ sạch và đau đang được kiểm soát. Chức năng thận bình thường.",
          "huong_xu_tri": "Tiếp tục ibuprofen và truyền dịch theo y lệnh. Tập vận động có nạng, chưa đặt tải chi. Theo dõi vết mổ và tưới máu chi trái. Nếu đau tăng bất thường, cần khám lại vết mổ và chi trái ngay.",
          "y_lenh_trong_ngay": [
            "YL-HS-017-01",
            "YL-HS-017-02"
          ],
          "che_do_cham_soc": "cấp 2",
          "che_do_an": "Cơm mềm, uống đủ nước",
          "theo_doi": [
            "Vết mổ và dịch thấm băng",
            "Đau khi vận động"
          ],
          "dan_do": "Tập gấp duỗi cổ chân và ngón chân để tránh huyết khối, đi lại có nạng."
        },
        {
          "phieu_dieu_tri_id": "PDT-HS-017-1-03",
          "ngay_dieu_tri": 3,
          "thoi_diem_lap": "2026-11-14T09:30:00+07:00",
          "vai_tro_nguoi_lap": "bac_si_dieu_tri",
          "dien_bien": "Ngày 2 sau mổ. BN còn đau khi vận động, đỡ đau khi nghỉ. Ăn uống được, tiểu tự nhiên. Mạch 86 lần/phút, huyết áp 120/76 mmHg, nhiệt độ 37,2 °C, creatinin 70 umol/L.",
          "danh_gia": "Sau mổ kết hợp xương ngày thứ 2, đau còn khi vận động nhưng đáp ứng tốt với giảm đau. Chức năng thận bình thường, sinh hiệu ổn định.",
          "huong_xu_tri": "Đề nghị ketorolac 30 mg tiêm tĩnh mạch mỗi 8 giờ để kiểm soát đau sau mổ, bắt đầu 10 giờ sáng nay, chờ duyệt. Tiếp tục ibuprofen và truyền dịch. Tiếp tục tập vận động, theo dõi vết mổ.",
          "y_lenh_trong_ngay": [
