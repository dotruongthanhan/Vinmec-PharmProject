      "phieu_dieu_tri": [
        {
          "phieu_dieu_tri_id": "PDT-HS-015-1-01",
          "ngay_dieu_tri": 1,
          "thoi_diem_lap": "2026-11-14T12:00:00+07:00",
          "vai_tro_nguoi_lap": "bac_si_dieu_tri",
          "dien_bien": "BN nữ 60 tuổi đau rát sau xương ức và ợ chua tăng 3 tuần, ăn không ngon. Đã dùng omeprazol 20 mg tại nhà nhưng triệu chứng chưa đỡ. Khám bụng mềm, đau nhẹ thượng vị, không đề kháng. Cân nặng 58 kg. Đã nhập khoa Tiêu hóa.",
          "danh_gia": "Trào ngược dạ dày thực quản, triệu chứng chưa đáp ứng với ức chế bơm proton liều dùng tại nhà. Chưa ghi nhận dấu hiệu xuất huyết tiêu hóa hay tắc nghẽn đường tiêu hóa trên khi thăm khám.",
          "huong_xu_tri": "Chỉ định omeprazol 20 mg uống hai lần mỗi ngày, trước ăn, và truyền natri clorid 0,9% mỗi ngày. Theo dõi đáp ứng triệu chứng và cân nặng. Ăn nhẹ nhiều bữa, không nằm ngay sau ăn.",
          "y_lenh_trong_ngay": [
            "YL-HS-015-01",
            "YL-HS-015-02"
          ],
          "che_do_cham_soc": "cấp 3",
          "che_do_an": "Cháo loãng, ăn chia nhỏ bữa",
          "theo_doi": [
            "Triệu chứng đau thượng vị và ợ chua mỗi ca",
            "Tình trạng nôn và màu phân"
          ],
          "dan_do": "Không nằm ngay sau khi ăn, kê đầu cao khi ngủ. Báo điều dưỡng nếu nôn ra máu hoặc đi ngoài phân đen."
        },
        {
          "phieu_dieu_tri_id": "PDT-HS-015-1-02",
          "ngay_dieu_tri": 2,
          "thoi_diem_lap": "2026-11-15T08:30:00+07:00",
          "vai_tro_nguoi_lap": "bac_si_dieu_tri",
          "dien_bien": "BN đỡ ợ chua một phần, vẫn đau thượng vị âm ỉ. Ăn được cháo loãng. Không nôn, không đi ngoài phân đen. Đang truyền natri clorid theo y lệnh.",
          "danh_gia": "Đáp ứng một phần với ức chế bơm proton. Chưa có dấu hiệu chảy máu tiêu hóa. Cần đánh giá lại đáp ứng sau 24 đến 48 giờ. Triệu chứng về đêm và khi ăn no cần được ghi nhận thêm.",
          "huong_xu_tri": "Tiếp tục omeprazol và truyền dịch theo y lệnh. Theo dõi triệu chứng và tình trạng ăn uống. Đánh giá lại đáp ứng vào ngày kế tiếp. Ghi nhận cân nặng và lượng ăn trong ca.",
          "y_lenh_trong_ngay": [
            "YL-HS-015-01",
            "YL-HS-015-02"
          ],
          "che_do_cham_soc": "cấp 3",
          "che_do_an": "Cháo loãng, chia nhỏ bữa",
          "theo_doi": [
            "Đau thượng vị và ợ chua",
            "Màu phân"
          ],
          "dan_do": "Tránh đồ cay, rượu bia, cà phê khi còn đau rát."
        },
        {
          "phieu_dieu_tri_id": "PDT-HS-015-1-03",
          "ngay_dieu_tri": 3,
          "thoi_diem_lap": "2026-11-16T08:30:00+07:00",
          "vai_tro_nguoi_lap": "bac_si_dieu_tri",
          "dien_bien": "Sáng nay đau thượng vị đã giảm so với hôm qua. Cân nặng 58 kg, ổn định. BN ăn được và không nôn. Tiếp tục theo dõi đáp ứng thuốc ức chế bơm proton.",
          "danh_gia": "Trào ngược dạ dày thực quản đang đáp ứng dần, cân nặng ổn định. Cần chọn phác đồ ức chế bơm proton phù hợp cho giai đoạn tiếp theo trước khi ra viện.",
          "huong_xu_tri": "Đề nghị esomeprazol 40 mg uống mỗi sáng, trước ăn, chờ duyệt. Tiếp tục theo dõi triệu chứng và đáp ứng. Dự kiến ra viện khi triệu chứng ổn định và ăn uống tốt.",
          "y_lenh_trong_ngay": [
            "YL-HS-015-01",
            "YL-HS-015-02",
            "YL-HS-015-03"
          ],
          "che_do_cham_soc": "cấp 3",
          "che_do_an": "Cháo, cơm mềm, ăn chia nhỏ bữa",
          "theo_doi": [
            "Triệu chứng đau thượng vị và ợ chua",
            "Cân nặng mỗi 2 ngày"
          ],
          "dan_do": "Uống thuốc ức chế bơm proton trước ăn sáng, không nằm ngay sau ăn."
        }
