      "tong_ket": "Viêm mô tế bào do MRSA chân trái, điều trị vancomycin 1 g truyền tĩnh mạch mỗi 12 giờ trong 6 ngày, đáp ứng tốt. Ra viện, tái khám ngoại trú nếu sưng đỏ trở lại.",
      "phieu_dieu_tri": [
        {
          "phieu_dieu_tri_id": "PDT-HS-047-1-01",
          "ngay_dieu_tri": 1,
          "thoi_diem_lap": "2026-05-10T11:30:00+07:00",
          "vai_tro_nguoi_lap": "bac_si_dieu_tri",
          "dien_bien": "BN nam vào viện vì sưng đỏ, nóng, đau cẳng chân trái 3 ngày, kèm sốt 38,2 °C. Không dùng kháng sinh trong 1 tháng nay. Khám: vùng cẳng chân trái sưng, đỏ, nóng và ấn đau, không có dấu hiệu nhiễm khuẩn huyết. Cân nặng 74 kg. Đã lấy dịch mủ làm cấy, chờ kết quả.",
          "danh_gia": "Viêm mô tế bào lan rộng nghi do tụ cầu, chưa có bệnh mạn tính đáng kể. Creatinin 96 umol/L lúc 10 giờ, cần theo dõi chức năng thận khi dùng vancomycin. Chưa có kết quả nuôi cấy nên tác nhân còn là giả định.",
          "huong_xu_tri": "Truyền vancomycin 1 g tĩnh mạch mỗi 12 giờ, chờ kết quả cấy để xác nhận tác nhân. Paracetamol 500 mg uống khi sốt, cách nhau tối thiểu 6 giờ. Đánh giá vùng sưng, sốt và creatinin trong quá trình điều trị.",
          "y_lenh_trong_ngay": [
            "YL-HS-047-01",
            "YL-HS-047-02"
          ],
          "che_do_cham_soc": "cấp 2",
          "che_do_an": "Ăn thường, nhiều đạm, uống đủ nước.",
          "theo_doi": [
            "Vùng sưng, đỏ, nóng",
            "Nhiệt độ",
            "Creatinin trước và sau khi dùng vancomycin"
          ],
          "dan_do": "Kê cao chân trái khi nghỉ, không tự nặn mủ."
        },
        {
          "phieu_dieu_tri_id": "PDT-HS-047-1-02",
          "ngay_dieu_tri": 2,
          "thoi_diem_lap": "2026-05-11T09:00:00+07:00",
          "vai_tro_nguoi_lap": "bac_si_dieu_tri",
          "dien_bien": "Vùng sưng giảm đôi chút, còn đau nhẹ khi đi lại. Kết quả cấy mủ: tụ cầu vàng kháng methicillin (MRSA), nhạy vancomycin. Đang dùng vancomycin đều đặn theo y lệnh. Người bệnh ăn uống được, ngủ được.",
          "danh_gia": "Viêm mô tế bào do MRSA đáp ứng bước đầu với vancomycin, chưa có dấu hiệu lan rộng hơn. Không sốt cao trong ngày. Cần tiếp tục theo dõi creatinin vì đang dùng thuốc có độc với thận.",
          "huong_xu_tri": "Tiếp tục vancomycin 1 g truyền tĩnh mạch mỗi 12 giờ. Theo dõi creatinin và vùng sưng, đánh giá lại vào ngày kế tiếp. Nhắc người bệnh báo ngay nếu sưng đỏ lan rộng.",
          "y_lenh_trong_ngay": [
            "YL-HS-047-01",
            "YL-HS-047-02"
          ],
          "che_do_cham_soc": "cấp 2",
          "che_do_an": "Ăn thường, đủ đạm.",
          "theo_doi": [
            "Vùng sưng",
            "Nhiệt độ",
            "Creatinin"
          ],
          "dan_do": "Tránh đi lại nhiều khi chân còn đau."
        },
        {
          "phieu_dieu_tri_id": "PDT-HS-047-1-03",
          "ngay_dieu_tri": 3,
          "thoi_diem_lap": "2026-05-12T09:00:00+07:00",
          "vai_tro_nguoi_lap": "bac_si_dieu_tri",
          "dien_bien": "Sưng đỏ tiếp tục giảm, đau ít hơn khi đi lại. Không sốt cao, ăn uống được, ngủ tốt. Không có mủ mới chảy ra từ vết chích cũ. Người bệnh ngủ đủ giấc và không có cơn đau về đêm.",
          "danh_gia": "Đáp ứng tốt với vancomycin, không có dấu hiệu nhiễm khuẩn huyết. Chức năng thận cần theo dõi thêm trong khi dùng vancomycin, chưa có tín hiệu bất thường được ghi nhận. Không có ù tai hay phát ban đáng kể.",
          "huong_xu_tri": "Tiếp tục vancomycin đều đặn theo y lệnh. Lấy creatinin sáng mai để đánh giá chức năng thận trong quá trình điều trị. Hướng dẫn người bệnh vận động nhẹ để tránh cứng khớp cổ chân.",
          "y_lenh_trong_ngay": [
            "YL-HS-047-01",
            "YL-HS-047-02"
          ],
          "che_do_cham_soc": "cấp 3",
          "che_do_an": "Ăn thường, nhiều đạm.",
          "theo_doi": [
            "Vùng sưng và đau",
            "Creatinin",
            "Nhiệt độ"
          ],
          "dan_do": "Giữ vệ sinh vùng da, thay băng theo khoa."
        },
        {
          "phieu_dieu_tri_id": "PDT-HS-047-1-04",
          "ngay_dieu_tri": 4,
          "thoi_diem_lap": "2026-05-13T09:00:00+07:00",
          "vai_tro_nguoi_lap": "bac_si_dieu_tri",
          "dien_bien": "Vùng sưng giảm, còn đau nhẹ, không sốt. Tiếp tục vancomycin đều theo y lệnh, không ghi nhận phản ứng bất thường như phát ban hay ù tai. Người bệnh đi lại được trong buồng bệnh có người hỗ trợ.",
          "danh_gia": "Viêm mô tế bào đang đáp ứng đúng hướng, sưng giảm rõ hơn ngày trước. Chưa ghi nhận biến chứng. Vùng da quanh tổn thương đã bớt căng và bớt nóng so với hôm vào viện.",
          "huong_xu_tri": "Tiếp tục vancomycin đến khi đủ liệu trình. Dự kiến đánh giá ra viện trong vài ngày nếu vùng nhiễm tiếp tục cải thiện. Kiểm tra lại creatinin theo lịch để theo dõi thận.",
          "y_lenh_trong_ngay": [
            "YL-HS-047-01",
            "YL-HS-047-02"
          ],
          "che_do_cham_soc": "cấp 3",
          "che_do_an": "Ăn thường.",
          "theo_doi": [
            "Vùng sưng, đỏ",
            "Nhiệt độ",
            "Ù tai, phát ban"
          ],
          "dan_do": "Nâng cao chân khi nghỉ."
        },
        {
          "phieu_dieu_tri_id": "PDT-HS-047-1-05",
          "ngay_dieu_tri": 5,
          "thoi_diem_lap": "2026-05-14T09:00:00+07:00",
          "vai_tro_nguoi_lap": "bac_si_dieu_tri",
          "dien_bien": "Vùng sưng tiếp tục giảm, không có mủ mới, không sốt. Đi lại được hơn so với những ngày đầu. Ăn uống tốt, ngủ được. Người bệnh hỏi về thời điểm ra viện và cách chăm sóc chân tại nhà.",
          "danh_gia": "Viêm mô tế bào đang lành dần, chưa ghi nhận biến chứng. Tiếp tục theo dõi chức năng thận do vancomycin, đây là điểm cần lưu ý khi ra viện. Creatinin sẽ được lấy lại trước khi ra viện để so sánh.",
          "huong_xu_tri": "Tiếp tục vancomycin đến liều cuối theo y lệnh. Chuẩn bị hướng dẫn tái khám ngoại trú, đánh giá ra viện vào sáng mai nếu không có thay đổi. Hướng dẫn người bệnh theo dõi vùng sưng tại nhà.",
          "y_lenh_trong_ngay": [
            "YL-HS-047-01",
            "YL-HS-047-02"
          ],
          "che_do_cham_soc": "cấp 3",
          "che_do_an": "Ăn thường, nhiều đạm.",
          "theo_doi": [
            "Vùng sưng",
            "Nhiệt độ",
            "Creatinin"
          ],
          "dan_do": "Không tự nặn mủ, tái khám khi sưng đỏ trở lại."
        },
        {
          "phieu_dieu_tri_id": "PDT-HS-047-1-06",
          "ngay_dieu_tri": 6,
          "thoi_diem_lap": "2026-05-15T09:00:00+07:00",
          "vai_tro_nguoi_lap": "bac_si_dieu_tri",
          "dien_bien": "Lúc 7 giờ: nhiệt độ 36,8 °C, vùng sưng giảm rõ, không mủ. Creatinin 84 umol/L lúc 6 giờ 30. Đi lại được, không sốt, không đau nhiều khi nghỉ. Người bệnh ăn uống tốt và không cần thêm thuốc giảm đau.",
          "danh_gia": "Viêm mô tế bào do MRSA đáp ứng tốt với vancomycin, không sốt, chức năng thận cải thiện so với lúc vào viện. Đủ điều kiện chuyển ra viện sau khi hoàn thành liệu trình. Không có dấu hiệu nhiễm khuẩn huyết trong suốt đợt điều trị.",
          "huong_xu_tri": "Hoàn thành vancomycin đến liều cuối theo y lệnh, dự kiến ra viện ngày kế tiếp. Dặn tái khám ngoại trú nếu sưng đỏ trở lại, theo dõi nhiệt độ tại nhà.",
          "y_lenh_trong_ngay": [
            "YL-HS-047-01",
            "YL-HS-047-02"
          ],
          "che_do_cham_soc": "cấp 3",
          "che_do_an": "Ăn thường.",
          "theo_doi": [
            "Vùng sưng, đỏ",
            "Nhiệt độ tại nhà",
            "Creatinin khi tái khám"
          ],
          "dan_do": "Giữ vùng da khô sạch, tránh chấn thương vùng chân trái."
        }
      ],
      "quan_ly": {
