      "phieu_dieu_tri": [
        {
          "phieu_dieu_tri_id": "PDT-HS-021-1-01",
          "ngay_dieu_tri": 1,
          "thoi_diem_lap": "2026-11-14T10:30:00+07:00",
          "vai_tro_nguoi_lap": "bac_si_dieu_tri",
          "dien_bien": "BN nam 40T vào viện vì đau, sưng, nóng, đỏ cẳng chân trái 3 ngày, kèm sốt nhẹ và đi lại đau. Chưa dùng kháng sinh trước khi vào viện. Khám: T 37,9 °C, cẳng chân trái đỏ, sưng, nóng, ấn đau; chưa thấy ổ mủ rõ; hạch bẹn không to. Người bệnh tỉnh, tiếp xúc tốt.",
          "danh_gia": "Viêm mô tế bào cẳng chân trái (L03.1), nhập khoa Truyền nhiễm. CRP 45 mg/L cho thấy viêm đang hoạt động; creatinin 79 umol/L trong giới hạn. Ngày đầu nhập viện nên chưa đánh giá được đáp ứng điều trị, cần theo dõi thêm để quyết định liệu trình kháng sinh.",
          "huong_xu_tri": "Truyền natri clorid 0,9% 500 mL tĩnh mạch, kê cao chi trái để giảm sưng. Làm lại creatinin và CRP vào sáng mai. Chưa kê kháng sinh trong ngày hôm nay, sẽ đánh giá lại theo kết quả xét nghiệm và diễn tiến tại chỗ.",
          "y_lenh_trong_ngay": [
            "YL-HS-021-01",
            "YL-HS-021-02"
          ],
          "che_do_cham_soc": "cấp 2",
          "che_do_an": "Ăn thường, uống đủ nước",
          "theo_doi": [
            "Nhiệt độ mỗi 6 giờ",
            "Đánh dấu bờ đỏ cẳng chân trái, theo dõi lan rộng",
            "Đau, sưng, nóng tại chỗ"
          ],
          "dan_do": "Kê cao chi trái khi nghỉ. Báo điều dưỡng nếu sốt cao hoặc vùng đỏ lan rộng."
        },
        {
          "phieu_dieu_tri_id": "PDT-HS-021-1-02",
          "ngay_dieu_tri": 2,
          "thoi_diem_lap": "2026-11-15T08:10:00+07:00",
          "vai_tro_nguoi_lap": "bac_si_dieu_tri",
          "dien_bien": "Cẳng chân trái còn đỏ, sưng, đỡ đau nhẹ so với hôm qua, chưa có ổ mủ. T 37,2 °C lúc 07:20, cân nặng 72 kg. BN đi lại được quanh giường, ăn uống khá, không có triệu chứng toàn thân nặng thêm. Hạch bẹn không to.",
          "danh_gia": "Viêm mô tế bào cẳng chân trái đáp ứng bước đầu: CRP giảm từ 45 xuống 28 mg/L, creatinin 82 umol/L vẫn trong giới hạn bình thường so với 79 umol/L hôm qua. Tình trạng tại chỗ còn sưng và đỏ nên chưa ổn định hoàn toàn, cần theo dõi thêm trước khi quyết định chuyển thuốc.",
          "huong_xu_tri": "Đề nghị vancomycin 500 mg uống mỗi 6 giờ, y lệnh đang chờ duyệt (chỉ định trong ngày hôm nay). Tiếp tục kê cao chi trái và theo dõi đáp ứng tại chỗ. Làm lại CRP và creatinin sau 48 giờ, đánh giá lại liệu trình khi có kết quả.",
          "y_lenh_trong_ngay": [
            "YL-HS-021-03",
            "YL-HS-021-04"
          ],
          "che_do_cham_soc": "cấp 2",
          "che_do_an": "Ăn thường, uống đủ nước",
          "theo_doi": [
            "Nhiệt độ mỗi 6 giờ",
            "Vùng đỏ, sưng cẳng chân trái",
            "Triệu chứng sốt, ớn lạnh"
          ],
          "dan_do": "Tiếp tục kê cao chi. Báo bác sĩ nếu đau tăng, da đỏ lan rộng hoặc sốt trở lại."
