      "phieu_dieu_tri": [
        {
          "phieu_dieu_tri_id": "PDT-HS-024-1-01",
          "ngay_dieu_tri": 1,
          "thoi_diem_lap": "2026-11-10T17:00:00+07:00",
          "vai_tro_nguoi_lap": "bac_si_dieu_tri",
          "dien_bien": "BN nam vào cấp cứu vì khó thở tăng và tim nhanh, đang theo dõi suy tim và rung nhĩ ngoại trú. Mạch 112 lần/phút, HA 118/74 mmHg, SpO2 95% khí phòng. Ran ẩm đáy phổi hai bên, nhịp nhanh không đều, gan không to. Cân nặng 77 kg.",
          "danh_gia": "Suy tim (I50.9) mất bù cấp kèm rung nhĩ nhanh (I48), đang dùng digoxin 0,25 mg mỗi ngày. Creatinin 92 umol/L và K 4,1 mmol/L trong giới hạn. Chưa có nồng độ digoxin máu trong ngày đầu nên chưa điều chỉnh liều.",
          "huong_xu_tri": "Tiếp tục digoxin 0,25 mg uống mỗi sáng. Truyền natri clorid 0,9% 500 mL mỗi ngày. Paracetamol khi sốt hoặc đau. Theo dõi nhịp tim, khó thở và chức năng thận trong 24 giờ đầu.",
          "y_lenh_trong_ngay": [
            "YL-HS-024-01",
            "YL-HS-024-02",
            "YL-HS-024-03"
          ],
          "che_do_cham_soc": "cấp 1",
          "che_do_an": "Ăn nhạt, hạn chế muối; uống khoảng 1,5 lít mỗi ngày",
          "theo_doi": [
            "Mạch, nhịp tim mỗi 4 giờ",
            "SpO2 và mức độ khó thở",
            "Cân nặng mỗi sáng"
          ],
          "dan_do": "Nằm đầu cao, báo điều dưỡng ngay nếu khó thở tăng hoặc đau ngực."
        },
        {
          "phieu_dieu_tri_id": "PDT-HS-024-1-02",
          "ngay_dieu_tri": 2,
          "thoi_diem_lap": "2026-11-11T08:45:00+07:00",
          "vai_tro_nguoi_lap": "bac_si_dieu_tri",
          "dien_bien": "Đỡ khó thở so với hôm vào viện, nhịp còn nhanh nhưng đã giảm. Nồng độ digoxin máu 1,4 ng/mL lấy lúc 06:00. Người bệnh ăn được một phần, không ghi nhận buồn nôn, nôn hay nhìn vàng quầng. Ran ẩm đáy phổi còn nhưng ít hơn.",
