      "tong_ket": "THA, bệnh thận mạn G2. Khởi trị losartan 50 mg/ngày, HA ổn định khi ra viện. Ra viện tiếp tục losartan 50 mg/ngày tại nhà.",
      "phieu_dieu_tri": [
        {
          "phieu_dieu_tri_id": "PDT-HS-014-1-01",
          "ngay_dieu_tri": 1,
          "thoi_diem_lap": "2026-02-03T11:30:00+07:00",
          "vai_tro_nguoi_lap": "bac_si_dieu_tri",
          "dien_bien": "BN nam 71 tuổi, tăng huyết áp nhiều năm, nhức đầu vùng chẩm 2 ngày, huyết áp tại nhà cao. Khám huyết áp 168/98 mmHg, tim đều, phổi không ran, phù nhẹ mu chân. Creatinin 98 umol/L. Bệnh thận mạn giai đoạn 2 đang theo dõi ngoại trú.",
          "danh_gia": "Tăng huyết áp chưa kiểm soát có triệu chứng nhức đầu, kèm bệnh thận mạn giai đoạn 2 với chức năng thận hiện còn trong giới hạn. Chưa dùng thuốc hạ áp trước khi vào viện.",
          "huong_xu_tri": "Khởi trị losartan 50 mg uống mỗi ngày. Truyền natri clorid 0,9% 500 mL mỗi ngày. Theo dõi huyết áp và chức năng thận, ghi nhận đáp ứng điều trị trong vài ngày tới.",
          "y_lenh_trong_ngay": [
            "YL-HS-014-01",
            "YL-HS-014-02"
          ],
          "che_do_cham_soc": "cấp 2",
          "che_do_an": "Cơm nhạt, ít muối, ít đạm",
          "theo_doi": [
            "Huyết áp mỗi 4 giờ",
            "Creatinin và kali sau 3 đến 5 ngày"
          ],
          "dan_do": "Đo huyết áp tại nhà mỗi sáng và ghi lại số đo. Báo khi nhức đầu nhiều hơn hoặc chóng mặt."
        },
        {
          "phieu_dieu_tri_id": "PDT-HS-014-1-02",
          "ngay_dieu_tri": 2,
          "thoi_diem_lap": "2026-02-04T09:00:00+07:00",
          "vai_tro_nguoi_lap": "bac_si_dieu_tri",
          "dien_bien": "Nhức đầu giảm nhẹ so với hôm vào viện. Huyết áp đo sáng nay giảm dần. BN ăn uống được, không chóng mặt, không khó thở.",
          "danh_gia": "Huyết áp đang giảm dần dưới tác dụng của losartan nhưng chưa về mục tiêu. Chức năng thận chưa có thay đổi bất lợi.",
          "huong_xu_tri": "Tiếp tục losartan 50 mg mỗi ngày, theo dõi huyết áp mỗi ngày. Chưa cần thay đổi thuốc hạ áp hôm nay. Theo dõi lượng nước tiểu trong khi truyền dịch. Truyền natri clorid 0,9% theo y lệnh, dự kiến kết thúc trong buổi sáng nay.",
          "y_lenh_trong_ngay": [
            "YL-HS-014-01",
            "YL-HS-014-02"
          ],
          "che_do_cham_soc": "cấp 2",
          "che_do_an": "Cơm nhạt, ít muối",
          "theo_doi": [
            "Huyết áp mỗi 6 giờ",
            "Triệu chứng nhức đầu và chóng mặt"
          ],
          "dan_do": "Đứng dậy từ từ khi vừa thức dậy để tránh chóng mặt."
        },
        {
          "phieu_dieu_tri_id": "PDT-HS-014-1-03",
          "ngay_dieu_tri": 3,
          "thoi_diem_lap": "2026-02-05T09:00:00+07:00",
          "vai_tro_nguoi_lap": "bac_si_dieu_tri",
          "dien_bien": "Huyết áp tiếp tục giảm, nhức đầu hết rõ rệt. BN ăn uống tốt, đi lại được trong khoa, ngủ được ban đêm. Không có phù tăng thêm, không khó thở.",
          "danh_gia": "Tăng huyết áp đáp ứng tốt với losartan. Chức năng thận chưa có dấu hiệu xấu đi trong quá trình điều trị.",
          "huong_xu_tri": "Tiếp tục losartan 50 mg mỗi ngày. Theo dõi huyết áp hằng ngày trước khi ra viện. Ghi nhận cân nặng và phù chi dưới trước khi ra viện. Chuẩn bị hướng dẫn dùng thuốc tại nhà. Đánh giá lại khả năng tự đo huyết áp của BN và người nhà trước khi ra viện.",
          "y_lenh_trong_ngay": [
            "YL-HS-014-01"
          ],
          "che_do_cham_soc": "cấp 3",
          "che_do_an": "Cơm nhạt, ít muối",
          "theo_doi": [
            "Huyết áp mỗi ngày",
            "Triệu chứng nhức đầu"
          ],
          "dan_do": "Uống losartan đúng giờ mỗi ngày, không bỏ liều."
        },
        {
          "phieu_dieu_tri_id": "PDT-HS-014-1-04",
          "ngay_dieu_tri": 4,
          "thoi_diem_lap": "2026-02-06T08:00:00+07:00",
          "vai_tro_nguoi_lap": "bac_si_dieu_tri",
          "dien_bien": "Huyết áp giảm dần còn ở mức an toàn hơn, hết nhức đầu. Creatinin ổn định so với lúc vào viện. BN không khó chịu, không phát ban, không chóng mặt.",
          "danh_gia": "Tăng huyết áp đang được kiểm soát dần. Chưa ghi nhận tác dụng không mong muốn của losartan. Bệnh thận mạn giai đoạn 2 ổn định. Chưa có triệu chứng chóng mặt khi đứng dậy.",
          "huong_xu_tri": "Tiếp tục losartan. Lên kế hoạch tái khám ngoại trú, xét nghiệm creatinin và kali sau khi ra viện. Dự kiến ra viện trong 1 đến 2 ngày. Tiếp tục theo dõi chế độ ăn nhạt tại khoa.",
          "y_lenh_trong_ngay": [
            "YL-HS-014-01"
          ],
          "che_do_cham_soc": "cấp 3",
          "che_do_an": "Cơm nhạt, ít muối",
          "theo_doi": [
            "Huyết áp mỗi ngày",
            "Phù mu chân"
          ],
          "dan_do": "Tiếp tục đo huyết áp tại nhà và ghi số đo để đưa đi tái khám."
        },
        {
          "phieu_dieu_tri_id": "PDT-HS-014-1-05",
          "ngay_dieu_tri": 5,
          "thoi_diem_lap": "2026-02-07T09:00:00+07:00",
          "vai_tro_nguoi_lap": "bac_si_dieu_tri",
          "dien_bien": "BN không đau đầu, không chóng mặt, ăn ngủ tốt. Phù mu chân giảm. Đi lại bình thường trong khoa. Gia đình đã được hướng dẫn về lịch tái khám. Dự kiến ra viện sáng mai.",
          "danh_gia": "Tăng huyết áp đã kiểm soát tương đối, bệnh thận mạn giai đoạn 2 ổn định. BN đủ điều kiện ra viện điều trị ngoại trú.",
          "huong_xu_tri": "Ra viện ngày mai. Tiếp tục losartan 50 mg mỗi ngày tại nhà. Hẹn tái khám tim mạch và xét nghiệm chức năng thận trong thời gian ngắn. Dặn BN mang theo đơn thuốc và sổ theo dõi huyết áp khi đi tái khám.",
          "y_lenh_trong_ngay": [
            "YL-HS-014-01"
          ],
          "che_do_cham_soc": "cấp 3",
          "che_do_an": "Cơm nhạt, ít muối",
          "theo_doi": [
            "Huyết áp tại nhà",
            "Phù mu chân"
          ],
          "dan_do": "Tái khám đúng hẹn, mang theo sổ theo dõi huyết áp khi đi khám."
        }
      ],
