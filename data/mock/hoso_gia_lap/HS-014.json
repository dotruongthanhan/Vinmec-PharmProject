      "tong_ket": null,
      "phieu_dieu_tri": [
        {
          "phieu_dieu_tri_id": "PDT-HS-014-2-01",
          "ngay_dieu_tri": 1,
          "thoi_diem_lap": "2026-11-14T10:00:00+07:00",
          "vai_tro_nguoi_lap": "bac_si_dieu_tri",
          "dien_bien": "BN nam 71 tuổi, tăng huyết áp và bệnh thận mạn giai đoạn 2, đang dùng losartan 50 mg mỗi ngày tại nhà. Nhức đầu vùng chẩm 3 ngày, huyết áp tại nhà cao. Khám huyết áp 162/96 mmHg, mạch 78 lần/phút, nhiệt độ bình thường, cân nặng 74 kg. Creatinin 101 umol/L, kali 4,5 mmol/L. Phù nhẹ mu chân hai bên.",
          "danh_gia": "Tăng huyết áp chưa kiểm soát kèm bệnh thận mạn giai đoạn 2. Creatinin và kali còn trong giới hạn bình thường. Nhức đầu có thể liên quan đến huyết áp cao.",
          "huong_xu_tri": "Tiếp tục losartan 50 mg mỗi sáng, truyền natri clorid 0,9% mỗi ngày, paracetamol khi đau đầu theo y lệnh. Theo dõi huyết áp và điện giải, đánh giá điều chỉnh thuốc hạ áp trong 48 giờ tới.",
          "y_lenh_trong_ngay": [
            "YL-HS-014-03",
            "YL-HS-014-04",
            "YL-HS-014-05"
          ],
          "che_do_cham_soc": "cấp 2",
          "che_do_an": "Cơm nhạt, ít muối, hạn chế đạm",
          "theo_doi": [
            "Huyết áp mỗi 6 giờ",
            "Creatinin và kali sau 48 giờ",
            "Phù chi dưới"
          ],
          "dan_do": "Nằm nghỉ khi đau đầu. Báo điều dưỡng nếu chóng mặt hoặc đau đầu nhiều hơn."
        },
        {
          "phieu_dieu_tri_id": "PDT-HS-014-2-02",
          "ngay_dieu_tri": 2,
          "thoi_diem_lap": "2026-11-15T08:30:00+07:00",
          "vai_tro_nguoi_lap": "bac_si_dieu_tri",
          "dien_bien": "Nhức đầu giảm nhiều so với hôm qua. Huyết áp chiều qua còn cao nhẹ. BN ăn uống được, không chóng mặt, không khó thở. Vẫn đang dùng losartan và truyền dịch theo y lệnh.",
          "danh_gia": "Huyết áp vẫn còn cao nhưng triệu chứng nhức đầu đã đỡ. Chức năng thận cần theo dõi thêm sau khi truyền dịch.",
          "huong_xu_tri": "Tiếp tục losartan và truyền natri clorid theo y lệnh. Theo dõi huyết áp, xét nghiệm creatinin và kali sáng mai. Đánh giá lại phác đồ hạ áp sau khi có kết quả. Nếu kali tăng thêm, cần cân nhắc lại thuốc trước khi tiếp tục.",
          "y_lenh_trong_ngay": [
            "YL-HS-014-03",
            "YL-HS-014-04",
            "YL-HS-014-05"
          ],
          "che_do_cham_soc": "cấp 2",
          "che_do_an": "Cơm nhạt, ít muối",
          "theo_doi": [
            "Huyết áp mỗi 6 giờ",
            "Triệu chứng nhức đầu"
          ],
          "dan_do": "Đo huyết áp và báo điều dưỡng nếu thấy số đo tăng hơn hôm qua."
        },
        {
          "phieu_dieu_tri_id": "PDT-HS-014-2-03",
          "ngay_dieu_tri": 3,
          "thoi_diem_lap": "2026-11-16T08:40:00+07:00",
          "vai_tro_nguoi_lap": "bac_si_dieu_tri",
          "dien_bien": "Sáng nay huyết áp 158/94 mmHg. Cân nặng 74 kg, không thay đổi so với hôm nhập viện. Creatinin 105 umol/L, kali 4,8 mmol/L (sát giới hạn trên bình thường). Nhức đầu nhiều lần đã giảm, BN ăn uống được.",
          "danh_gia": "Tăng huyết áp còn chưa kiểm soát dù đang dùng losartan 50 mg mỗi ngày. Creatinin tăng nhẹ so với ngày 14, kali sát giới hạn trên. Cần cân nhắc tăng cường thuốc hạ áp và theo dõi sát chức năng thận và kali.",
          "huong_xu_tri": "Đề nghị enalapril 10 mg uống mỗi sáng, bắt đầu 9 giờ sáng nay, chờ duyệt. Tiếp tục losartan 50 mg mỗi ngày. Theo dõi huyết áp, creatinin và kali sau khi điều chỉnh thuốc.",
          "y_lenh_trong_ngay": [
            "YL-HS-014-03",
            "YL-HS-014-04",
            "YL-HS-014-05",
            "YL-HS-014-06"
          ],
          "che_do_cham_soc": "cấp 2",
          "che_do_an": "Cơm nhạt, ít muối, hạn chế đạm",
          "theo_doi": [
            "Huyết áp mỗi 4 giờ",
            "Creatinin và kali sau 24 giờ",
            "Phù chi dưới"
          ],
          "dan_do": "Báo điều dưỡng nếu chóng mặt khi đứng dậy hoặc nhức đầu tăng trở lại."
        }
