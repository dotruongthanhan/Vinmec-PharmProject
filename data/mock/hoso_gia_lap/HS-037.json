      "phieu_dieu_tri": [
        {
          "phieu_dieu_tri_id": "PDT-HS-037-1-01",
          "ngay_dieu_tri": 1,
          "thoi_diem_lap": "2026-11-11T16:30:00+07:00",
          "vai_tro_nguoi_lap": "bac_si_dieu_tri",
          "dien_bien": "BN nữ 61 tuổi, ung thư phổi đã biết đang theo dõi ngoại trú, vào viện vì đau ngực lan lưng tăng dần 2 tuần, đau nhiều về đêm. Tỉnh, gầy, cân nặng 52 kg, chiều cao 158 cm. Phổi giảm rì rào phế nang đáy phổi phải, bụng mềm, chưa ghi nhận phù. Creatinin 71 umol/L.",
          "danh_gia": "Đau do ung thư phổi, mức đau nặng ảnh hưởng giấc ngủ, cần kiểm soát đau tích cực. Chức năng thận trong giới hạn bình thường.",
          "huong_xu_tri": "Truyền natri clorid 0,9% 500 mL trong 8 giờ theo y lệnh. Đánh giá đau và tác dụng phụ của thuốc giảm đau trong ngày kế.",
          "y_lenh_trong_ngay": [
            "YL-HS-037-01"
          ],
          "che_do_cham_soc": "cấp 2",
          "che_do_an": "Ăn mềm, chia nhỏ bữa, đủ đạm, uống đủ nước.",
          "theo_doi": [
            "Mức đau theo thang điểm",
            "Giấc ngủ và buồn nôn",
            "Cân nặng hằng tuần"
          ],
          "dan_do": "Báo điều dưỡng khi đau tăng hoặc khó thở."
        },
        {
          "phieu_dieu_tri_id": "PDT-HS-037-1-02",
          "ngay_dieu_tri": 2,
          "thoi_diem_lap": "2026-11-12T10:30:00+07:00",
          "vai_tro_nguoi_lap": "bac_si_dieu_tri",
          "dien_bien": "Đau vùng ngực còn nhiều, khó ngủ. Ăn kém, buồn nôn nhẹ sau khi uống thuốc. Chưa khó thở. BN được hướng dẫn tư thế nằm nghiêng và thở chậm để giảm đau. Điều dưỡng ghi nhận BN đã ăn được vài thìa cháo.",
          "danh_gia": "Đau do ung thư chưa kiểm soát đủ, có tác dụng phụ tiêu hóa nhẹ. Cần đánh giá lại phác đồ giảm đau trong các ngày tới. Đau vẫn là vấn đề chính, cần đánh giá lại theo thang điểm mỗi ngày.",
          "huong_xu_tri": "Paracetamol 1 g uống mỗi 6 giờ theo y lệnh, theo dõi buồn nôn và mức đau. Tiếp tục dịch truyền. Điều dưỡng theo dõi buồn nôn sau mỗi lần dùng thuốc uống.",
          "y_lenh_trong_ngay": [
            "YL-HS-037-01",
            "YL-HS-037-02"
          ],
          "che_do_cham_soc": "cấp 2",
          "che_do_an": "Ăn mềm, chia nhỏ bữa, đủ đạm, uống đủ nước.",
          "theo_doi": [
            "Mức đau theo thang điểm",
            "Buồn nôn và nôn",
            "Giấc ngủ"
          ],
          "dan_do": "Uống thuốc sau bữa ăn nhẹ để giảm buồn nôn."
        },
        {
          "phieu_dieu_tri_id": "PDT-HS-037-1-03",
          "ngay_dieu_tri": 3,
          "thoi_diem_lap": "2026-11-13T10:00:00+07:00",
          "vai_tro_nguoi_lap": "bac_si_dieu_tri",
          "dien_bien": "Buồn nôn đã giảm sau khi dùng thuốc chống nôn tiêm tĩnh mạch. Đau vùng ngực lan lưng còn mức vừa đến nặng, VAS 6/10. Mạch 86, HA 118/72 mmHg, BN còn mệt. Điều dưỡng ghi nhận BN tự xoay trở trên giường và uống nước đều hơn.",
          "danh_gia": "Buồn nôn đáp ứng tốt với ondansetron. Đau còn mức vừa đến nặng, chưa đủ kiểm soát. Tác dụng phụ tiêu hóa đang được kiểm soát tốt hơn so với các ngày đầu.",
          "huong_xu_tri": "Tiếp tục paracetamol 1 g mỗi 6 giờ và ondansetron 4 mg tiêm tĩnh mạch mỗi 8 giờ. Đánh giá đau và giấc ngủ vào ngày kế. Điều dưỡng ghi nhận mức đau trước và sau mỗi lần dùng thuốc giảm đau.",
          "y_lenh_trong_ngay": [
            "YL-HS-037-01",
            "YL-HS-037-02",
            "YL-HS-037-03"
          ],
