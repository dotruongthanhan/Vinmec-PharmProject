      "tong_ket": null,
      "phieu_dieu_tri": [
        {
          "phieu_dieu_tri_id": "PDT-HS-045-1-01",
          "ngay_dieu_tri": 1,
          "thoi_diem_lap": "2026-11-10T15:15:00+07:00",
          "vai_tro_nguoi_lap": "bac_si_dieu_tri",
          "dien_bien": "BN nữ vào cấp cứu vì sốt, ho đàm vàng 3 ngày và khó thở nhẹ khi gắng sức, chưa dùng kháng sinh trước khi vào viện. Khám lúc 14 giờ 30: nhiệt độ 38,8 °C, SpO2 94% khí phòng, mạch nhanh, ran ẩm đáy phổi phải. Người bệnh tỉnh, tiếp xúc tốt, cân nặng 58 kg.",
          "danh_gia": "Viêm phổi cộng đồng (J18.9) cần điều trị nội trú, sốt cao và SpO2 94% khí phòng, chưa có suy hô hấp nặng. Creatinin 82 umol/L ghi nhận lúc 15 giờ, là mức nền trước khi dùng kháng sinh tĩnh mạch. Người bệnh có tuổi cao nên cần theo dõi sát tri giác và nhịp thở.",
          "huong_xu_tri": "Truyền natri clorid 0,9% 500 mL mỗi ngày. Đã chỉ định X-quang ngực và cấy máu, đề nghị kháng sinh tĩnh mạch sau khi lấy mẫu, chọn thuốc theo đáp ứng và kết quả cấy. Theo dõi SpO2 và nhiệt độ mỗi 4 giờ.",
          "y_lenh_trong_ngay": [
            "YL-HS-045-01"
          ],
          "che_do_cham_soc": "cấp 2",
          "che_do_an": "Cháo hoặc cơm mềm, uống đủ nước.",
          "theo_doi": [
            "Nhiệt độ và SpO2 mỗi 4 giờ",
            "Ho và lượng đờm",
            "Khó thở khi gắng sức"
          ],
          "dan_do": "Ho khạc đờm đúng cách, không nằm bằng khi khó thở; báo ngay nếu khó thở tăng."
        },
        {
          "phieu_dieu_tri_id": "PDT-HS-045-1-02",
          "ngay_dieu_tri": 2,
          "thoi_diem_lap": "2026-11-11T09:00:00+07:00",
          "vai_tro_nguoi_lap": "bac_si_dieu_tri",
          "dien_bien": "Còn sốt, đã dùng paracetamol theo y lệnh khi sốt cao. Ho đàm ít hơn, khó thở nhẹ hơn. Ăn uống được, SpO2 khí phòng ổn định, không cần thở oxy theo ghi nhận hiện tại. Người bệnh được hướng dẫn tập thở và ho khạc đờm, không có đau ngực mới.",
          "danh_gia": "Viêm phổi cộng đồng đang đáp ứng chậm, sốt chưa hạ hẳn. Cần theo dõi thêm để đánh giá đáp ứng với điều trị. Chưa có dấu hiệu suy hô hấp tiến triển trong ngày, nhưng cần theo dõi sát do người bệnh tuổi cao.",
          "huong_xu_tri": "Tiếp tục truyền natri clorid 0,9% và theo dõi nhiệt độ, SpO2. Chờ kết quả cấy máu để chọn kháng sinh tĩnh mạch phù hợp. Theo dõi dấu hiệu khó thở và lơ mơ để báo bác sĩ sớm.",
          "y_lenh_trong_ngay": [
            "YL-HS-045-01",
            "YL-HS-045-02"
          ],
          "che_do_cham_soc": "cấp 2",
          "che_do_an": "Cháo, cơm mềm.",
          "theo_doi": [
            "Nhiệt độ và SpO2",
            "Ho đàm, khó thở",
            "Kết quả cấy máu"
          ],
          "dan_do": "Tập thở sâu, ho đúng cách, uống đủ nước."
        },
        {
          "phieu_dieu_tri_id": "PDT-HS-045-1-03",
          "ngay_dieu_tri": 3,
          "thoi_diem_lap": "2026-11-12T07:50:00+07:00",
          "vai_tro_nguoi_lap": "bac_si_dieu_tri",
          "dien_bien": "Sáng nay nhiệt độ 37,4 °C, SpO2 96% khí phòng, mạch 88 lần/phút, HA 128/76 mmHg lúc 7 giờ. Ho đàm ít, ăn uống được, tỉnh táo. Creatinin 78 umol/L lúc 6 giờ 40, cân nặng 58 kg.",
          "danh_gia": "Viêm phổi cộng đồng đáp ứng về lâm sàng: sốt đã dưới 38 độ, SpO2 cải thiện. Chức năng thận qua creatinin 78 umol/L. Cần tiếp tục kháng sinh tĩnh mạch đầy đủ theo kế hoạch, chưa đủ cơ sở để chuyển thuốc uống.",
          "huong_xu_tri": "Đề nghị ceftriaxon 1 g truyền tĩnh mạch mỗi 12 giờ để tiếp tục kháng sinh tĩnh mạch (chỉ định, chờ duyệt). Tiếp tục natri clorid 0,9% mỗi ngày và paracetamol khi sốt trên 38,5 độ. Theo dõi nhiệt độ và SpO2 để đánh giá lại sau khi bắt đầu kháng sinh.",
          "y_lenh_trong_ngay": [
            "YL-HS-045-01",
            "YL-HS-045-02",
            "YL-HS-045-03"
          ],
          "che_do_cham_soc": "cấp 2",
          "che_do_an": "Cháo hoặc cơm mềm, uống đủ nước.",
          "theo_doi": [
            "Nhiệt độ và SpO2 mỗi 4 giờ",
            "Ho đàm"
          ],
          "dan_do": "Ngồi dậy khi ăn, uống đủ nước; báo ngay nếu khó thở tăng."
