      "tong_ket": null,
      "phieu_dieu_tri": [
        {
          "phieu_dieu_tri_id": "PDT-HS-018-1-01",
          "ngay_dieu_tri": 1,
          "thoi_diem_lap": "2026-11-12T10:30:00+07:00",
          "vai_tro_nguoi_lap": "bac_si_truc",
          "dien_bien": "BN nam 75 tuổi sốt cao, ho đàm vàng và khó thở nhẹ khi gắng sức 3 ngày, chưa dùng kháng sinh trước khi vào viện. Khám tỉnh, ran ẩm đáy phổi phải, không tím. Cân nặng 62 kg. XQ phổi có đám mờ đáy phổi phải. Đã bắt đầu ceftriaxon 2 g tiêm tĩnh mạch và truyền natri clorid 0,9% 500 mL.",
          "danh_gia": "Viêm phổi cộng đồng đáy phổi phải, tác nhân chưa rõ. Chưa có suy hô hấp nặng khi khám ban đầu. Theo dõi sát đáp ứng lâm sàng và chức năng thận.",
          "huong_xu_tri": "Tiếp tục ceftriaxon 2 g mỗi 24 giờ và truyền dịch theo y lệnh. Theo dõi sốt, SpO2 và nhịp thở. Làm xét nghiệm chức năng thận và công thức máu để đánh giá.",
          "y_lenh_trong_ngay": [
            "YL-HS-018-01",
            "YL-HS-018-02"
          ],
          "che_do_cham_soc": "cấp 2",
          "che_do_an": "Cháo, cơm mềm, uống đủ nước",
          "theo_doi": [
            "SpO2 và nhịp thở mỗi 4 giờ",
            "Nhiệt độ mỗi 6 giờ",
            "Lượng nước tiểu mỗi ngày"
          ],
          "dan_do": "Khạc đờm khi cần, ngồi đầu cao khi nằm. Báo điều dưỡng nếu khó thở tăng."
        },
        {
          "phieu_dieu_tri_id": "PDT-HS-018-1-02",
          "ngay_dieu_tri": 2,
          "thoi_diem_lap": "2026-11-13T08:30:00+07:00",
          "vai_tro_nguoi_lap": "bac_si_dieu_tri",
          "dien_bien": "Sốt giảm nhiều so với hôm qua, ho ít hơn, còn khó thở nhẹ khi gắng sức. Creatinin 124 umol/L. Đang tiếp tục ceftriaxon và truyền dịch. BN ăn uống được hơn và ngủ tốt hơn.",
          "danh_gia": "Viêm phổi đáp ứng bước đầu với ceftriaxon. Creatinin ở mức cao, cần theo dõi sát chức năng thận và điều chỉnh thuốc theo chức năng thận.",
          "huong_xu_tri": "Tiếp tục ceftriaxon và truyền dịch. Theo dõi đáp ứng lâm sàng và chức năng thận để quyết định kháng sinh tiếp theo nếu cần. Ghi nhận lượng nước tiểu mỗi ca để đánh giá chức năng thận.",
          "y_lenh_trong_ngay": [
            "YL-HS-018-01",
            "YL-HS-018-02"
          ],
          "che_do_cham_soc": "cấp 2",
          "che_do_an": "Cơm mềm, uống đủ nước",
          "theo_doi": [
            "SpO2 và nhịp thở mỗi 4 giờ",
            "Nhiệt độ mỗi 6 giờ",
            "Lượng nước tiểu"
          ],
          "dan_do": "Ho khạc đờm, báo điều dưỡng nếu khó thở khi nghỉ hoặc sốt cao trở lại."
        },
        {
          "phieu_dieu_tri_id": "PDT-HS-018-1-03",
          "ngay_dieu_tri": 3,
          "thoi_diem_lap": "2026-11-14T09:30:00+07:00",
          "vai_tro_nguoi_lap": "bac_si_dieu_tri",
          "dien_bien": "Sốt giảm nhiều, T 37,4 °C, SpO2 95%, mạch 96 lần/phút, huyết áp 118/74 mmHg. Creatinin 130 umol/L, bạch cầu 13,2 G/L. Ho ít, còn khó thở nhẹ khi gắng sức.",
          "danh_gia": "Viêm phổi cộng đồng đang cải thiện về lâm sàng, bạch cầu còn cao nhẹ. Creatinin tăng cao, cần theo dõi sát chức năng thận trong quá trình điều trị kháng sinh.",
          "huong_xu_tri": "Ngưng ceftriaxon từ 9 giờ sáng nay. Chuyển sang levofloxacin 750 mg truyền tĩnh mạch mỗi 12 giờ, bắt đầu 10 giờ sáng nay, chờ duyệt, theo chỉ định bác sĩ điều trị. Tiếp tục theo dõi sốt, SpO2 và chức năng thận.",
