      "tong_ket": "Rung nhĩ mới, nhịp nhanh đã kiểm soát. Warfarin 5 mg buổi tối, tái khám theo dõi INR. Ra viện ổn định.",
      "phieu_dieu_tri": [
        {
          "phieu_dieu_tri_id": "PDT-HS-042-1-01",
          "ngay_dieu_tri": 1,
          "thoi_diem_lap": "2025-12-02T11:00:00+07:00",
          "vai_tro_nguoi_lap": "bac_si_dieu_tri",
          "dien_bien": "BN nữ vào viện vì đánh trống ngực, mệt và khó thở khi gắng sức 3 ngày. Khám: mạch 118 lần/phút không đều, HA 138/82 mmHg, phổi không ran, không phù. ECG ghi nhận rung nhĩ đáp ứng thất nhanh. INR 1,1 lúc 8 giờ 30, chưa dùng thuốc chống đông trước khi vào viện.",
          "danh_gia": "Rung nhĩ mới khởi phát (I48) với nhịp nhanh, có tiền sử tăng huyết áp. Chưa có dấu hiệu suy tim mất bù hay thiếu máu cơ tim trên lâm sàng. Cần dự phòng huyết khối bằng thuốc chống đông đường uống, nền INR hiện tại là 1,1 nên chưa có ảnh hưởng của thuốc.",
          "huong_xu_tri": "Khởi trị warfarin 5 mg uống buổi tối, điều chỉnh liều theo INR trong suốt đợt điều trị. Kiểm soát nhịp và theo dõi mạch, huyết áp hằng ngày. Lấy INR lại trước khi ra viện và giải thích cho người bệnh về lịch xét nghiệm.",
          "y_lenh_trong_ngay": [
            "YL-HS-042-01"
          ],
          "che_do_cham_soc": "cấp 2",
          "che_do_an": "Ăn nhạt, ít muối, duy trì lượng rau xanh ổn định mỗi ngày.",
          "theo_doi": [
            "Mạch và nhịp tim",
            "Huyết áp hai lần mỗi ngày",
            "Chảy máu chân răng, bầm tím"
          ],
          "dan_do": "Uống warfarin đúng giờ buổi tối, không tự đổi liều. Báo ngay nếu chảy máu hoặc đi phân đen."
        },
        {
          "phieu_dieu_tri_id": "PDT-HS-042-1-02",
          "ngay_dieu_tri": 2,
          "thoi_diem_lap": "2025-12-03T09:00:00+07:00",
          "vai_tro_nguoi_lap": "bac_si_dieu_tri",
          "dien_bien": "Đánh trống ngực giảm dần, mệt đỡ hơn so với ngày vào viện. Không đau ngực, không ngất, không khó thở khi nằm. Đã dùng warfarin buổi tối hôm trước theo y lệnh, chưa ghi nhận chảy máu. Ăn uống được, đi tiểu bình thường, không chóng mặt khi đứng dậy.",
          "danh_gia": "Rung nhĩ đang kiểm soát nhịp tương đối tốt, nhịp nhanh giảm rõ so với ngày vào viện. Cần theo dõi INR để điều chỉnh liều warfarin, hôm nay chưa có kết quả INR trong hồ sơ. Chưa ghi nhận biến cố thuyên tắc hay chảy máu lớn.",
          "huong_xu_tri": "Tiếp tục warfarin 5 mg buổi tối và kiểm soát nhịp theo y lệnh. Lấy INR theo lịch của khoa. Theo dõi triệu chứng chảy máu và tình trạng tim mạch. Đánh giá lại sau mỗi lần có kết quả INR.",
          "y_lenh_trong_ngay": [
            "YL-HS-042-01"
          ],
          "che_do_cham_soc": "cấp 2",
          "che_do_an": "Ăn nhạt, cơm mềm, uống đủ nước.",
          "theo_doi": [
            "Mạch và nhịp tim",
            "Huyết áp hai lần mỗi ngày"
          ],
          "dan_do": "Đi lại nhẹ trong buồng bệnh, báo nếu đánh trống ngực tăng trở lại."
        },
        {
          "phieu_dieu_tri_id": "PDT-HS-042-1-03",
          "ngay_dieu_tri": 3,
          "thoi_diem_lap": "2025-12-04T09:00:00+07:00",
          "vai_tro_nguoi_lap": "bac_si_dieu_tri",
          "dien_bien": "Tỉnh, tiếp xúc tốt, đi lại trong buồng bệnh không mệt nhiều. Nhịp tim đều hơn so với các ngày trước, không đánh trống ngực đáng kể. Không ghi nhận xuất huyết dưới da hay chảy máu niêm mạc. Người bệnh ăn uống tốt, không có triệu chứng mới cần xử trí.",
          "danh_gia": "Rung nhĩ đáp ứng tốt với kiểm soát nhịp, warfarin đang khởi trị. Chưa có INR giữa đợt trong hồ sơ để đánh giá ổn định, cần xét nghiệm để quyết định liều. Tình trạng chung ổn, chưa có biến cố cần thay đổi kế hoạch.",
          "huong_xu_tri": "Tiếp tục warfarin 5 mg uống buổi tối. Hẹn lấy INR vào sáng ngày kế tiếp để quyết định liều trước khi ra viện. Theo dõi huyết áp và mạch hai lần mỗi ngày. Ghi chép liều warfarin đã dùng vào bệnh án.",
          "y_lenh_trong_ngay": [
            "YL-HS-042-01"
          ],
          "che_do_cham_soc": "cấp 2",
          "che_do_an": "Ăn nhạt, chia nhiều bữa nhẹ.",
          "theo_doi": [
            "Mạch và nhịp tim",
            "Chảy máu, bầm tím",
            "Huyết áp"
          ],
          "dan_do": "Không tự ý dùng thêm thuốc giảm đau nhóm chống viêm không steroid."
        },
        {
          "phieu_dieu_tri_id": "PDT-HS-042-1-04",
          "ngay_dieu_tri": 4,
          "thoi_diem_lap": "2025-12-05T09:00:00+07:00",
          "vai_tro_nguoi_lap": "bac_si_dieu_tri",
          "dien_bien": "Sinh hoạt gần bình thường, không mệt nhiều, không khó thở. Huyết áp và nhịp tim được theo dõi theo y lệnh, không có triệu chứng mới. Người bệnh hiểu cách uống warfarin buổi tối. Người nhà được hướng dẫn nhận biết dấu hiệu chảy máu và khi nào cần quay lại khám.",
          "danh_gia": "Rung nhĩ kiểm soát nhịp ổn định, tăng huyết áp chưa có biến cố. Dự kiến cho ra viện trong 1 đến 2 ngày nếu INR có kết quả phù hợp. Chưa có kết quả INR giữa đợt để so sánh với lần đầu.",
          "huong_xu_tri": "Tiếp tục warfarin 5 mg buổi tối đến khi ra viện. Lấy INR sáng ngày mai trước khi ra viện, dặn lịch tái khám và xét nghiệm INR theo hẹn. Ghi rõ ngày tái khám trong giấy ra viện.",
          "y_lenh_trong_ngay": [
            "YL-HS-042-01"
          ],
          "che_do_cham_soc": "cấp 2",
          "che_do_an": "Ăn nhạt, đủ đạm, hạn chế rượu bia.",
          "theo_doi": [
            "Mạch và nhịp tim",
            "Huyết áp",
            "Dấu hiệu chảy máu"
          ],
          "dan_do": "Ghi rõ liều warfarin trong giấy ra viện, tái khám và xét nghiệm INR đúng hẹn."
        }
      ],
