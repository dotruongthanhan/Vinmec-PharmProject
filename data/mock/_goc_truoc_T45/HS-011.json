      "tong_ket": null,
      "phieu_dieu_tri": [
        {
          "phieu_dieu_tri_id": "PDT-HS-011-1-01",
          "ngay_dieu_tri": 1,
          "thoi_diem_lap": "2026-11-10T16:30:00+07:00",
          "vai_tro_nguoi_lap": "bac_si_dieu_tri",
          "dien_bien": "BN nam 52 tuổi vào viện vì sỏi niệu quản phải trên siêu âm, đau hông lưng phải từng cơn. Hiện tỉnh táo, chưa sốt. Khám bụng mềm, ấn đau nhẹ hố thắt lưng phải, phổi trong. Cân nặng 70 kg, chiều cao 170 cm. Nhịn ăn chuẩn bị mổ, đã truyền Ringer lactat 500 mL trước mổ.",
          "danh_gia": "Sỏi niệu quản phải có đau quặn thắt lưng, chỉ định lấy sỏi bằng phẫu thuật. Ghi nhận dị ứng sulfonamid (phát ban) trong EMR. Tiền sử bản thân và gia đình chưa ghi nhận bệnh mạn tính đáng kể.",
          "huong_xu_tri": "Dự kiến mổ lấy sỏi niệu quản phải ngày mai. Tiếp tục nhịn ăn và truyền dịch đến trước mổ, theo dõi đau và sinh hiệu. Sau mổ sẽ dùng giảm đau theo y lệnh, theo dõi vết mổ và nước tiểu.",
          "y_lenh_trong_ngay": [
            "YL-HS-011-01"
          ],
          "che_do_cham_soc": "cấp 2",
          "che_do_an": "Nhịn ăn chuẩn bị mổ",
          "theo_doi": [
            "Mạch, huyết áp, nhiệt độ mỗi 6 giờ",
            "Mức đau hông lưng và tình trạng tiểu"
          ],
          "dan_do": "Báo điều dưỡng khi đau tăng hoặc có sốt."
        },
        {
          "phieu_dieu_tri_id": "PDT-HS-011-1-02",
          "ngay_dieu_tri": 2,
          "thoi_diem_lap": "2026-11-11T17:00:00+07:00",
          "vai_tro_nguoi_lap": "bac_si_dieu_tri",
          "dien_bien": "Đã phẫu thuật lấy sỏi niệu quản phải trong ngày. Vết mổ khô sạch, nước tiểu vàng trong. Đau vừa, đang dùng giảm đau theo y lệnh. Chưa ghi nhận sốt, không buồn nôn. BN bắt đầu đi lại được trong phòng.",
          "danh_gia": "Sau lấy sỏi niệu quản phải tiến triển ban đầu tốt. Cần theo dõi nguy cơ nhiễm khuẩn tiết niệu sau can thiệp đường tiết niệu, đặc biệt khi có sỏi và đặt thông niệu quản.",
          "huong_xu_tri": "Truyền natri clorid 0,9% 500 mL mỗi 12 giờ để bù dịch. Tiếp tục giảm đau, tập đi lại sớm trong phòng. Theo dõi nhiệt độ và triệu chứng tiểu buốt trong 24 giờ tới.",
          "y_lenh_trong_ngay": [
            "YL-HS-011-02"
          ],
          "che_do_cham_soc": "cấp 2",
          "che_do_an": "Ăn lỏng khi có nhu động ruột, chuyển cơm mềm nếu dung nạp tốt",
          "theo_doi": [
            "Nhiệt độ mỗi 6 giờ",
            "Lượng nước tiểu và màu nước tiểu mỗi ca"
          ],
          "dan_do": "Uống đủ nước, không nín tiểu, báo điều dưỡng nếu sốt hoặc tiểu buốt tăng."
        },
        {
          "phieu_dieu_tri_id": "PDT-HS-011-1-03",
          "ngay_dieu_tri": 3,
          "thoi_diem_lap": "2026-11-12T08:45:00+07:00",
          "vai_tro_nguoi_lap": "bac_si_dieu_tri",
          "dien_bien": "Ngày sau mổ thứ 1. BN đi lại được, tiểu buốt và tiểu nhiều lần hơn bình thường. Sáng nay còn sốt nhẹ. Đau hông lưng phải còn nhưng đỡ hơn hôm qua. Vết mổ khô, không chảy dịch. Creatinin 98 umol/L.",
          "danh_gia": "Nhiễm khuẩn tiết niệu sau mổ sỏi niệu quản đang có triệu chứng kích thích đường tiểu và sốt nhẹ. Chức năng thận còn trong giới hạn bình thường, creatinin 98 umol/L.",
          "huong_xu_tri": "Lấy mẫu cấy nước tiểu giữa dòng trước khi dùng kháng sinh, theo y lệnh đã kê hôm nay. Tiếp tục truyền dịch, theo dõi sốt và triệu chứng tiểu. Chờ kết quả cấy để lựa chọn kháng sinh phù hợp.",
          "y_lenh_trong_ngay": [
            "YL-HS-011-02",
            "YL-HS-011-03"
          ],
          "che_do_cham_soc": "cấp 2",
          "che_do_an": "Cơm mềm, uống nhiều nước",
          "theo_doi": [
            "Nhiệt độ mỗi 4 giờ",
            "Triệu chứng tiểu buốt, tiểu lắt nhắt",
