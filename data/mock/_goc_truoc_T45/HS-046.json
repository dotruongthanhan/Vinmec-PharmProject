      "tong_ket": null,
      "phieu_dieu_tri": [
        {
          "phieu_dieu_tri_id": "PDT-HS-046-1-01",
          "ngay_dieu_tri": 1,
          "thoi_diem_lap": "2026-11-09T12:00:00+07:00",
          "vai_tro_nguoi_lap": "bac_si_dieu_tri",
          "dien_bien": "BN nam vào cấp cứu sau cơn co giật toàn thân khoảng 3 phút tại nhà, tự hết và tỉnh hoàn toàn sau cơn. Không sốt, không chấn thương đầu. Khám lúc 11 giờ: nhiệt độ 36,9 °C, HA 132/82 mmHg, không có dấu thần kinh khu trú. Cân nặng 68 kg, creatinin 90 umol/L lúc 11 giờ 30.",
          "danh_gia": "Cơn co giật toàn thân trên nền động kinh đã biết (G40.9). Người bệnh đã không dùng thuốc chống động kinh khoảng 1 tháng trước khi vào viện, đây là yếu tố đáng chú ý trong bệnh cảnh này. Chưa có cơn tái phát tại viện.",
          "huong_xu_tri": "Chỉ định điện não đồ và chụp CT sọ. Truyền natri clorid 0,9% mỗi ngày, paracetamol khi đau đầu. Đánh giá khởi trị thuốc chống động kinh sau khi có kết quả điện não đồ.",
          "y_lenh_trong_ngay": [
            "YL-HS-046-01",
            "YL-HS-046-02"
          ],
          "che_do_cham_soc": "cấp 2",
          "che_do_an": "Ăn mềm, dễ tiêu, uống đủ nước.",
          "theo_doi": [
            "Tri giác và cơn co giật",
            "Đau đầu",
            "Dấu hiệu yếu liệt"
          ],
          "dan_do": "Nằm nghỉ, giữ thành giường an toàn; báo ngay nếu co giật lại."
        },
        {
          "phieu_dieu_tri_id": "PDT-HS-046-1-02",
          "ngay_dieu_tri": 2,
          "thoi_diem_lap": "2026-11-10T09:00:00+07:00",
          "vai_tro_nguoi_lap": "bac_si_dieu_tri",
          "dien_bien": "Không co giật lại. Tỉnh, đau đầu nhẹ, ăn uống được. Đang chờ kết quả điện não đồ và CT sọ. Người nhà ở bên cạnh theo dõi trong buồng bệnh. Người bệnh được hướng dẫn nằm nghiêng nếu buồn nôn.",
          "danh_gia": "Tình trạng thần kinh ổn định sau cơn đơn lẻ, chưa có dấu hiệu khu trú. Đau đầu nhẹ sau cơn, cần theo dõi thêm. Chưa có thay đổi về tri giác so với lúc vào viện.",
          "huong_xu_tri": "Theo dõi tri giác và tần suất cơn co giật. Chờ điện não đồ để quyết định khởi trị thuốc chống động kinh. Tiếp tục natri clorid và paracetamol theo y lệnh. Ghi nhận giờ đau đầu để đánh giá lại.",
          "y_lenh_trong_ngay": [
            "YL-HS-046-01",
            "YL-HS-046-02"
          ],
          "che_do_cham_soc": "cấp 2",
          "che_do_an": "Ăn mềm, dễ tiêu.",
          "theo_doi": [
            "Tri giác",
            "Cơn co giật",
            "Đau đầu"
          ],
          "dan_do": "Không tự đi lại một mình trong thời gian đầu."
        },
        {
          "phieu_dieu_tri_id": "PDT-HS-046-1-03",
          "ngay_dieu_tri": 3,
          "thoi_diem_lap": "2026-11-11T09:00:00+07:00",
          "vai_tro_nguoi_lap": "bac_si_dieu_tri",
          "dien_bien": "Không co giật, tỉnh, tiếp xúc tốt, không yếu liệt. Chưa có thuốc chống động kinh được kê trong đợt này. Ăn uống bình thường. Ngủ được vào ban đêm, không có cơn tái phát trong đêm.",
          "danh_gia": "Động kinh với một cơn toàn thân đơn lẻ, chưa tái phát. Cần quyết định điều trị phòng ngừa sau khi có điện não đồ. Người bệnh có nguy cơ tái phát cao trong những tuần đầu nếu không được điều trị phòng ngừa.",
          "huong_xu_tri": "Chờ kết quả điện não đồ, theo dõi nguy cơ co giật tái phát. Đánh giá lại thuốc chống động kinh vào sáng mai nếu chưa có thay đổi. Trao đổi với người nhà về nguy cơ co giật và cách sơ cứu khi có cơn.",
          "y_lenh_trong_ngay": [
            "YL-HS-046-01",
            "YL-HS-046-02"
          ],
          "che_do_cham_soc": "cấp 2",
          "che_do_an": "Ăn thường, mềm.",
          "theo_doi": [
            "Tri giác",
            "Buồn ngủ",
            "Cơn co giật"
          ],
          "dan_do": "Tránh thức khuya, không uống rượu bia."
        },
        {
          "phieu_dieu_tri_id": "PDT-HS-046-1-04",
          "ngay_dieu_tri": 4,
          "thoi_diem_lap": "2026-11-12T07:40:00+07:00",
          "vai_tro_nguoi_lap": "bac_si_dieu_tri",
          "dien_bien": "Không co giật lại sau 3 ngày nội trú. Tỉnh, tiếp xúc tốt, không yếu liệt. Lúc 7 giờ: HA 126/78 mmHg, mạch 80 lần/phút, creatinin 85 umol/L lúc 6 giờ 40.",
          "danh_gia": "Động kinh có cơn toàn thân đơn lẻ, đã ổn định không co giật trong 3 ngày. Có chỉ định khởi trị thuốc chống động kinh để phòng ngừa tái phát. Chức năng thận qua creatinin 85 umol/L, chưa có chống chỉ định rõ với thuốc đang cân nhắc.",
          "huong_xu_tri": "Đề nghị khởi trị levetiracetam 500 mg uống 2 lần mỗi ngày, bắt đầu 8 giờ sáng nay (chỉ định, chờ duyệt). Tiếp tục natri clorid và paracetamol khi đau đầu. Theo dõi tri giác và đánh giá lại sau khi bắt đầu thuốc.",
          "y_lenh_trong_ngay": [
            "YL-HS-046-01",
            "YL-HS-046-02",
            "YL-HS-046-03"
          ],
          "che_do_cham_soc": "cấp 2",
          "che_do_an": "Ăn thường, mềm.",
          "theo_doi": [
            "Tri giác và cơn co giật",
            "Buồn nôn, buồn ngủ sau khi dùng thuốc",
            "HA và mạch mỗi ngày"
          ],
          "dan_do": "Không lái xe, không leo trèo khi chưa có chỉ định; báo ngay nếu co giật lại hoặc yếu liệt."
        }
      ]
    }
  ],
