      "tong_ket": "Viêm phế quản cấp, dị ứng cotrimoxazol (phát ban) đã ngừng thuốc, ho giảm, ra viện. Ghi nhận dị ứng sulfonamide.",
      "phieu_dieu_tri": [
        {
          "phieu_dieu_tri_id": "PDT-HS-056-1-01",
          "ngay_dieu_tri": 1,
          "thoi_diem_lap": "2026-06-10T11:00:00+07:00",
          "vai_tro_nguoi_lap": "bac_si_dieu_tri",
          "dien_bien": "BN nam 45T, ho đờm khoảng một tuần, sốt nhẹ, đau họng, không khó thở. Khám: T 37,8 °C, SpO2 97%, ran ẩm rải rác hai phổi, họng đỏ nhẹ. Tiền sử không đáng kể, chưa dùng thuốc đáng kể trước khi vào viện.",
          "danh_gia": "Viêm phế quản cấp, sốt nhẹ, chưa có dấu hiệu suy hô hấp. Không có ghi nhận dị ứng thuốc tại thời điểm nhập viện.",
          "huong_xu_tri": "Sulfamethoxazol kết hợp trimethoprim 800/160 mg, uống 1 viên mỗi 12 giờ, dùng trong nhiều ngày theo phác đồ. Paracetamol 500 mg uống khi sốt, cách nhau tối thiểu 6 giờ, theo dõi đáp ứng ho và sốt.",
          "y_lenh_trong_ngay": [
            "YL-HS-056-01",
            "YL-HS-056-02"
          ],
          "che_do_cham_soc": "cấp 3",
          "che_do_an": "Ăn cơm thường, uống đủ nước",
          "theo_doi": [
            "Thân nhiệt mỗi 6 giờ",
            "Ho và lượng đờm",
            "Phát ban hoặc ngứa da sau khi dùng thuốc"
          ],
          "dan_do": "Người bệnh báo điều dưỡng ngay nếu có phát ban, ngứa, sốt cao hoặc khó thở sau khi uống thuốc."
        },
        {
          "phieu_dieu_tri_id": "PDT-HS-056-1-02",
          "ngay_dieu_tri": 2,
          "thoi_diem_lap": "2026-06-11T09:00:00+07:00",
          "vai_tro_nguoi_lap": "bac_si_dieu_tri",
          "dien_bien": "Ho đờm giảm dần, sốt đã bớt, không khó thở. Người bệnh vẫn uống thuốc theo y lệnh, chưa ghi nhận phát ban và da bình thường đến thời điểm khám sáng nay.",
          "danh_gia": "Viêm phế quản cấp đáp ứng điều trị tốt trong giai đoạn đầu. Cần tiếp tục theo dõi tác dụng không mong muốn của thuốc trên da. Thời điểm này cần ghi nhận rõ mọi triệu chứng mới trên da để đánh giá thuốc, đặc biệt trong vài ngày đầu.",
          "huong_xu_tri": "Tiếp tục điều trị theo y lệnh đang dùng, kiểm tra da mỗi ca. Dự kiến ra viện sớm nếu ho tiếp tục giảm và không sốt. Ghi chép đầy đủ tình trạng ho và da trong hồ sơ điều dưỡng.",
          "y_lenh_trong_ngay": [
            "YL-HS-056-01",
            "YL-HS-056-02"
          ],
          "che_do_cham_soc": "cấp 3",
          "che_do_an": "Ăn cơm thường, uống đủ nước",
          "theo_doi": [
            "Thân nhiệt mỗi 8 giờ",
            "Da và niêm mạc",
            "Ho và lượng đờm"
          ],
          "dan_do": "Người bệnh tiếp tục báo điều dưỡng khi thấy ngứa hoặc nổi mẩn đỏ trên da."
        },
        {
          "phieu_dieu_tri_id": "PDT-HS-056-1-03",
          "ngay_dieu_tri": 3,
          "thoi_diem_lap": "2026-06-12T10:00:00+07:00",
          "vai_tro_nguoi_lap": "bac_si_dieu_tri",
          "dien_bien": "Ngày thứ ba dùng thuốc, người bệnh nổi phát ban đỏ toàn thân kèm ngứa, không khó thở. Đã ngừng sulfamethoxazol kết hợp trimethoprim lúc 09 giờ 30, ghi nhận phản ứng phát ban sau sulfonamid, mức độ trung bình. Paracetamol vẫn dùng khi sốt.",
          "danh_gia": "Phát ban do thuốc nhóm sulfonamid, không có dấu hiệu phản vệ hay khó thở. Cần ghi nhận dị ứng sulfonamid vào hồ sơ và theo dõi da đến khi thuyên giảm.",
          "huong_xu_tri": "Ngừng sulfamethoxazol kết hợp trimethoprim theo y lệnh. Không kê kháng sinh thay thế trong đợt này khi chưa có chỉ định, theo dõi triệu chứng hô hấp và phát ban mỗi ca.",
          "y_lenh_trong_ngay": [
            "YL-HS-056-01",
            "YL-HS-056-02"
          ],
          "che_do_cham_soc": "cấp 3",
          "che_do_an": "Ăn cơm thường, uống đủ nước",
          "theo_doi": [
            "Phát ban và mức ngứa",
            "Khó thở, sưng môi hoặc lưỡi",
            "Thân nhiệt mỗi 6 giờ"
          ],
          "dan_do": "Người bệnh không tự mua hoặc dùng lại thuốc nhóm sulfonamid, báo ngay nếu khó thở hoặc phát ban lan rộng."
        },
        {
          "phieu_dieu_tri_id": "PDT-HS-056-1-04",
          "ngay_dieu_tri": 4,
          "thoi_diem_lap": "2026-06-13T09:00:00+07:00",
          "vai_tro_nguoi_lap": "bac_si_dieu_tri",
          "dien_bien": "Phát ban đã giảm, ngứa ít hơn, không khó thở. Ho giảm rõ, chỉ còn ho ít đờm. Paracetamol khi sốt vẫn theo y lệnh, không sốt trong ca khám sáng nay.",
          "danh_gia": "Viêm phế quản cấp đang hồi phục, phản ứng dị ứng thuốc đang thuyên giảm sau khi ngừng sulfonamid. Đủ điều kiện xem xét ra viện trong ngày mai. Việc theo dõi tiếp theo sẽ giúp khẳng định phản ứng dị ứng đã thuyên giảm hoàn toàn trước khi ra viện.",
          "huong_xu_tri": "Tiếp tục theo dõi da và ho đến khi ra viện, hướng dẫn tránh dùng lại sulfonamid. Hẹn tái khám theo lịch của khoa Hô hấp. Hướng dẫn người bệnh mang theo thông tin dị ứng khi tái khám.",
          "y_lenh_trong_ngay": [
            "YL-HS-056-02"
          ],
          "che_do_cham_soc": "cấp 3",
          "che_do_an": "Ăn cơm thường, uống đủ nước",
          "theo_doi": [
            "Da và mức ngứa",
            "Ho và đờm",
            "Thân nhiệt trước khi ra viện"
          ],
          "dan_do": "Người bệnh mang theo thông tin dị ứng sulfonamid khi đi khám ở nơi khác, tái khám sớm nếu phát ban trở lại."
        }
      ]
    },
