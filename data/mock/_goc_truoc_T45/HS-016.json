      "tong_ket": null,
      "phieu_dieu_tri": [
        {
          "phieu_dieu_tri_id": "PDT-HS-016-1-01",
          "ngay_dieu_tri": 1,
          "thoi_diem_lap": "2026-11-13T16:30:00+07:00",
          "vai_tro_nguoi_lap": "bac_si_dieu_tri",
          "dien_bien": "BN nam 67 tuổi, rung nhĩ đã biết, đang dùng rivaroxaban 20 mg mỗi ngày tại nhà. Hồi hộp và đánh trống ngực 1 ngày. Khám tim không đều, mạch 96 lần/phút, phổi không ran, không phù. Cân nặng 80 kg.",
          "danh_gia": "Rung nhĩ có đợt nhịp nhanh gây hồi hộp, huyết động còn ổn. Đang dùng thuốc chống đông đường uống, cần theo dõi chức năng thận và huyết sắc tố trong quá trình điều trị.",
          "huong_xu_tri": "Tiếp tục rivaroxaban 20 mg mỗi tối cùng bữa ăn. Kiểm soát nhịp tim và theo dõi triệu chứng hồi hộp. Xét nghiệm creatinin và huyết sắc tố vào sáng mai.",
          "y_lenh_trong_ngay": [
            "YL-HS-016-01",
            "YL-HS-016-02"
          ],
          "che_do_cham_soc": "cấp 2",
          "che_do_an": "Ăn thường, hạn chế rượu bia và cà phê",
          "theo_doi": [
            "Mạch và nhịp tim mỗi 4 giờ",
            "Dấu hiệu chảy máu: phân đen, chảy máu chân răng"
          ],
          "dan_do": "Không tự ý ngưng rivaroxaban. Báo ngay nếu chảy máu, đau đầu đột ngột hoặc hồi hộp tăng."
        },
        {
          "phieu_dieu_tri_id": "PDT-HS-016-1-02",
          "ngay_dieu_tri": 2,
          "thoi_diem_lap": "2026-11-14T08:30:00+07:00",
          "vai_tro_nguoi_lap": "bac_si_dieu_tri",
          "dien_bien": "Hết hồi hộp. BN ăn uống bình thường, không khó thở. Nhịp tim còn không đều nhưng tần số chậm lại so với hôm qua. Creatinin 86 umol/L, huyết sắc tố 129 g/L.",
          "danh_gia": "Cơn nhịp nhanh đã được kiểm soát tốt. Chức năng thận bình thường. Huyết sắc tố hơi thấp so với ngưỡng bình thường, cần theo dõi lặp lại.",
          "huong_xu_tri": "Tiếp tục rivaroxaban và theo dõi kiểm soát nhịp. Theo dõi huyết sắc tố lặp lại và dấu hiệu chảy máu. Theo dõi tiếp trong khoa. Đánh giá lại nhịp tim khi BN đi lại và khi nghỉ.",
          "y_lenh_trong_ngay": [
            "YL-HS-016-01",
            "YL-HS-016-02"
          ],
          "che_do_cham_soc": "cấp 2",
          "che_do_an": "Ăn thường",
          "theo_doi": [
            "Mạch và nhịp tim mỗi 6 giờ",
            "Dấu hiệu chảy máu"
          ],
          "dan_do": "Đứng dậy từ từ, báo điều dưỡng nếu chóng mặt hoặc mệt nhiều."
        },
        {
          "phieu_dieu_tri_id": "PDT-HS-016-1-03",
          "ngay_dieu_tri": 3,
          "thoi_diem_lap": "2026-11-15T08:30:00+07:00",
          "vai_tro_nguoi_lap": "bac_si_dieu_tri",
          "dien_bien": "BN không còn đánh trống ngực, ăn ngủ được, đi lại trong khoa bình thường. Không ghi nhận chảy máu. Mạch ổn khi nghỉ, không có cơn hồi hộp mới trong đêm.",
          "danh_gia": "Rung nhĩ ổn định về triệu chứng khi dùng kiểm soát nhịp và chống đông đường uống. Chưa có biến chứng. Tiếp tục theo dõi dấu hiệu chảy máu trong thời gian nằm viện.",
          "huong_xu_tri": "Tiếp tục điều trị hiện tại, theo dõi nhịp tim và dấu hiệu chảy máu. Chuẩn bị xét nghiệm lặp lại vào sáng mai. Ghi chép đầy đủ giờ uống thuốc chống đông mỗi ngày.",
          "y_lenh_trong_ngay": [
            "YL-HS-016-01",
            "YL-HS-016-02"
          ],
          "che_do_cham_soc": "cấp 3",
          "che_do_an": "Ăn thường",
          "theo_doi": [
            "Mạch và nhịp tim mỗi ca",
            "Dấu hiệu chảy máu"
          ],
          "dan_do": "Tiếp tục uống rivaroxaban đúng giờ mỗi tối."
        },
        {
          "phieu_dieu_tri_id": "PDT-HS-016-1-04",
          "ngay_dieu_tri": 4,
          "thoi_diem_lap": "2026-11-16T08:30:00+07:00",
          "vai_tro_nguoi_lap": "bac_si_dieu_tri",
          "dien_bien": "Sáng nay BN ổn, không hồi hộp. Cân nặng 80 kg. Creatinin 88 umol/L, huyết sắc tố 128 g/L. Không ghi nhận chảy máu mới. Không có cơn hồi hộp mới trong 24 giờ qua.",
          "danh_gia": "Rung nhĩ kiểm soát triệu chứng tốt. Huyết sắc tố giảm nhẹ so với ngày 14, cần theo dõi chảy máu. Chức năng thận bình thường.",
          "huong_xu_tri": "Đề nghị enoxaparin 40 mg tiêm dưới da mỗi sáng, bắt đầu 8 giờ sáng nay, chờ duyệt. Tiếp tục rivaroxaban 20 mg mỗi tối. Theo dõi chảy máu và huyết sắc tố. Đánh giá lại huyết sắc tố trước khi ra viện.",
          "y_lenh_trong_ngay": [
            "YL-HS-016-01",
            "YL-HS-016-02",
            "YL-HS-016-03"
          ],
          "che_do_cham_soc": "cấp 2",
          "che_do_an": "Ăn thường",
          "theo_doi": [
            "Vị trí tiêm dưới da",
            "Dấu hiệu chảy máu",
            "Huyết sắc tố lặp lại theo chỉ định"
          ],
          "dan_do": "Báo điều dưỡng ngay nếu phân đen, nôn ra máu hoặc chảy máu chân răng kéo dài."
        }
      ]
    }
  ],
