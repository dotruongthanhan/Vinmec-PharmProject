        {"dien_bien_id": "DB-HS037-01", "loai_ho_so": "Phiếu khám", "noi_dung": "BN vào viện vì đau ngực lan lưng do ung thư phổi, VAS 7/10, đau nhiều về đêm. Tỉnh, T 36,8, mạch 88, HA 118/74. Cn 52 kg.", "thoi_diem_ghi": "2026-11-11T15:00:00+07:00"},
        {"dien_bien_id": "DB-HS037-02", "loai_ho_so": "Tờ điều trị", "noi_dung": "Ngày 1 nằm viện. Đau vùng ngực còn nhiều, khó ngủ. Ăn kém, buồn nôn nhẹ sau uống thuốc. Chưa khó thở.", "thoi_diem_ghi": "2026-11-12T08:00:00+07:00"},
        {"dien_bien_id": "DB-HS037-03", "loai_ho_so": "Tờ điều trị", "noi_dung": "Ngày 2. Buồn nôn giảm. Đau VAS 6/10. Mạch 86, HA 118/72. Tiếp tục theo dõi đau và tác dụng phụ thuốc.", "thoi_diem_ghi": "2026-11-13T08:00:00+07:00"},
        {"dien_bien_id": "DB-HS037-04", "loai_ho_so": "Tờ điều trị", "noi_dung": "Ngày 3. Đau VAS 6–7/10 vùng ngực lan lưng, mệt nhiều. Mạch 90, HA 116/72, T 37,0. Ngủ được vài giờ.", "thoi_diem_ghi": "2026-11-14T08:00:00+07:00"},
        {"dien_bien_id": "DB-HS037-05", "loai_ho_so": "Tờ điều trị", "noi_dung": "Ngày 4 nằm viện. Đau VAS 7/10 vùng ngực lan lưng, không khó thở, SpO2 96%. Cn 52 kg, creatinin 74 umol/L. Cần điều chỉnh thuốc giảm đau.", "thoi_diem_ghi": "2026-11-15T08:00:00+07:00"}
