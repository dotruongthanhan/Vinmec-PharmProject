OPENROUTER_API_KEY=
OPENROUTER_API_KEY_2=
DEEPSEEK_API_KEY=
DATABASE_URL=
# Nguồn ca bệnh: file giữ hành vi cũ; db đọc Supabase qua DATABASE_URL, chỉ SELECT.
CASE_SOURCE=file
# Nguồn kho tri thức (tra_cuu, ddinter, doan_trich): auto | file | db.
KB_SOURCE=auto

# Bắt buộc xác thực; off chỉ dùng khi phát triển cục bộ.
AUTH_MODE=required
# Thời gian đệm kiểm trực tuyến (giây), kẹp trong 10–300; mặc định 60.
AUTH_ONLINE_TTL=60
# Nhật ký truy cập tối giản, giữ 90 ngày; off để tắt.
ACCESS_LOG=on
# Địa chỉ dự án và khoá công khai cho kiểm thu hồi trực tuyến.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR-SUPABASE-ANON-KEY
# Chỉ điền khi dự án còn dùng HS256; để trống nếu dùng JWKS.
SUPABASE_JWT_SECRET=
# Nguồn web được phép, phân tách bằng dấu phẩy.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Giới hạn chi phí LLM: hỏi đáp mỗi 5 phút/người, AI mỗi giờ/người, tổng lượt LLM mỗi ngày (giờ VN).
LLM_ASK_PER_5MIN=20
LLM_AI_PER_HOUR=15
LLM_DAILY_CALLS=600

# Khoá miễn phí cho LLM; GEMINI_API_KEY là khoá trả phí cho nhúng.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=
GEMINI_API_KEY_7=
GEMINI_API_KEY_8=
