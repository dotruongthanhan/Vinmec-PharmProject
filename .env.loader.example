# Chuỗi kết nối dành riêng cho các script nạp/xuất bản dữ liệu (app.db.cli, app.kb.dictionary.publish).
# Dùng tài khoản vinmec_loader; KHÔNG đưa biến này vào .env.app hay container API.
DATABASE_URL_LOADER=postgresql://vinmec_loader:<mật-khẩu>@<host>:5432/<db>?sslmode=verify-full&sslrootcert=./certs/rds-global-bundle.pem
